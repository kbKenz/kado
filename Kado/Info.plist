<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>GIDClientID</key>
	<string>$(GOOGLE_CALENDAR_CLIENT_ID)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>Google Calendar OAuth</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>$(GOOGLE_CALENDAR_REVERSED_CLIENT_ID)</string>
			</array>
		</dict>
	</array>
	<key>CFBundleSpokenName</key>
	<string>Kado</string>
	<key>INAlternativeAppNames</key>
	<array>
		<dict>
			<key>INAlternativeAppName</key>
			<string>Kado</string>
		</dict>
	</array>
	<key>NSMicrophoneUsageDescription</key>
	<string>Kadō uses the microphone only while you dictate into a text field. Your words are turned into text on this device; audio is never stored or sent.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Speech recognition runs on this device only, to turn what you dictate into text. Nothing you say leaves your device.</string>
</dict>
</plist>
